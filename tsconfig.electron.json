{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "outDir": ".tmp/dist-electron",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
  },
  "include": [
    "src/electron"
  ]
}