{
  "name": "qbychat-web",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "license": "GPL-3.0",
  "main": ".tmp/dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite build && vite preview",
    "postinstall": "node ./node_modules/electron/install.js",
    "electron": "node scripts/dev-electron.cjs",
    "transpile:electron": "tsc --project tsconfig.electron.json",
    "electron:dist:mac": "pnpm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "electron:dist:win": "pnpm run transpile:electron && npm run build && electron-builder --win --x64",
    "electron:dist:linux": "pnpm run transpile:electron && npm run build && electron-builder --linux --x64",
    "generate:proto": "pnpm exec buf generate"
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@bufbuild/buf": "^1.54.0",
    "@bufbuild/protobuf": "^2.4.0",
    "@mantine/core": "^8.0.1",
    "@mantine/form": "^8.0.1",
    "@mantine/hooks": "^8.0.1",
    "@tailwindcss/vite": "^4.1.5",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.9.0",
    "camelcase-keys": "^9.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^12.9.6",
    "i18next": "^25.0.2",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-http-backend": "^3.0.2",
    "immer": "^10.1.1",
    "js-sha256": "^0.11.0",
    "libsodium-wrappers-sumo": "^0.7.15",
    "loglevel": "^1.9.2",
    "lucide-react": "^0.511.0",
    "mini-svg-data-uri": "^1.4.4",
    "mitt": "^3.0.1",
    "motion": "^12.10.0",
    "queue": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.5.1",
    "react-resizable-panels": "^3.0.1",
    "react-responsive": "^10.0.1",
    "react-virtualized": "^9.22.6",
    "tailwindcss": "^4.1.5",
    "ua-parser-js": "^2.0.3",
    "uuid": "^11.1.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-virtualized": "^9.22.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "glob": "^11.0.2",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
