{
  "appId": "org.cubewhy.qbychat",
  "directories": {
    "output": "dist-electron"
  },
  "extraMetadata": {
    "main": "main.js"
  },
  "extraResources": [
    "resources/**"
  ],
  "files": [
    "dist/**",
    {
      "from": ".tmp/dist-electron",
      "to": "./",
      "filter": [
        "**/*"
      ]
    }
  ],
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility"
  },
  "win": {
    "target": [
      "portable",
      "msi"
    ]
  }
}